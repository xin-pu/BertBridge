<Window x:Class="BertBridge.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BertBridge.GUI.Views"
        Title="BertBridge" Height="520" Width="920">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Refresh" Command="{Binding LoadDevicesCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
        </ToolBar>
        <views:DeviceListView />
    </DockPanel>
</Window>
